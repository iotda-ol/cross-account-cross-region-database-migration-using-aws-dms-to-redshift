# Environment Configuration
environment  = "dev"
project_name = "dms-migration"

# Region Configuration
target_region = "eu-west-1"
source_region = "us-east-1"

# Cross-Account Configuration
source_account_id       = "123456789012"  # Replace with your source AWS account ID
source_account_role_arn = "arn:aws:iam::123456789012:role/cross-account-dms-role"  # Replace with actual role ARN

# Network Configuration
target_vpc_cidr              = "10.0.0.0/16"
target_private_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
target_public_subnet_cidrs   = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]
availability_zones           = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]

# Source RDS Configuration (in source account)
source_rds_endpoint      = "source-rds-instance.abcdefghijkl.us-east-1.rds.amazonaws.com"
source_rds_port          = 5432
source_rds_database_name = "sourcedb"
source_rds_username      = "postgres"
source_rds_password      = "ChangeMe123!"  # Use AWS Secrets Manager in production

# Redshift Configuration (in target account)
redshift_cluster_identifier = "dms-target-redshift"
redshift_database_name      = "targetdb"
redshift_master_username    = "admin"
redshift_master_password    = "ChangeMe456!"  # Use AWS Secrets Manager in production
redshift_node_type          = "dc2.large"
redshift_number_of_nodes    = 2

# DMS Configuration
dms_replication_instance_id    = "dms-replication-instance"
dms_replication_instance_class = "dms.t3.medium"
dms_allocated_storage          = 100
dms_engine_version            = "3.5.2"
dms_multi_az                  = false
dms_publicly_accessible       = false

# Migration Configuration
migration_type = "full-load-and-cdc"

# Security Configuration
allowed_cidr_blocks    = []  # Add CIDR blocks if you need to access Redshift from specific IPs
enable_cloudwatch_logs = true

# Additional Tags
tags = {
  Owner       = "DataTeam"
  CostCenter  = "Engineering"
  Compliance  = "GDPR"
}
